{
  "name": "xdom-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "vars": {
    "CHAT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell"
  }
}
